# macOS
.DS_Store

# Swift Package Manager / Xcode build output
.build/
build/
DerivedData/
*.xcuserstate
xcuserdata/
*.pcm
*.sdkstatcache
ModuleCache/

# Signed app bundles and provisioning material
*.app/
*.mobileprovision
*.ipa
*.dSYM/

# Generated Xcode project (xcodegen rebuilds it)
Agent/AuscultAgent.xcodeproj/
# Generated by xcodegen from Mac/project.yml, like the agent's.
Mac/Auscult.xcodeproj/

# Intermediate vector output of Scripts/generate-icons.sh (the script is the
# source of truth). The rasters it produces ARE committed, so building needs
# no rsvg-convert.
Resources/Icons/*.svg

# Live task monitor output (~/.claude/tools) — written into whichever repo it serves
task-monitor.html

# Raw device dumps carry identifiers
p-*.json
*-report.txt
*.mobiledevicepairing
